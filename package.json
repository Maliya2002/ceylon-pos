{
  "name": "restaurant-pos-srilanka",
  "version": "1.0.0",
  "description": "Sri Lankan Restaurant POS System (Rice & Curry, Kottu, Short Eats) with Neon PostgreSQL, Express, React, and ESC/POS Printing",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "build": "prisma generate && cd client && npm install --include=dev && npm run build",
    "postinstall": "prisma generate",
    "server": "node server/src/index.js",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"API,WEB\" -c \"magenta,cyan\" \"npm run server\" \"npm run client\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.20.0",
    "uuid": "^10.0.0"
  }
}
